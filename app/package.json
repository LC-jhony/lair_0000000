{
  "name": "lair-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lair desktop application (React + Electron) for Linux, macOS and Windows",
  "homepage": "https://github.com/LC-jhony/lair",
  "author": {
    "name": "LC-jhony",
    "email": "jhonyapm94@gmail.com"
  },
  "desktopName": "lair.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:dev": "electron .",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "actions:check": "node scripts/check-actions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "sh.lair.desktop",
    "productName": "Lair",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    }
  }
}
